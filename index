<script>
// ── HERO CANVAS — halftone dots reacting to mouse ──
const canvas = document.getElementById('heroCanvas');
const ctx = canvas.getContext('2d');
let W, H, dots = [], mouse = {x:-9999,y:-9999}, t = 0;

function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    initDots();
}

function initDots() {
    dots = [];
    const sp = 40;
    for (let i = 0; i < Math.ceil(W/sp)+2; i++) {
        for (let j = 0; j < Math.ceil(H/sp)+2; j++) {
            dots.push({
                x: i*sp + sp/2, y: j*sp + sp/2,
                baseR: Math.random()*1.6 + 0.4,
                phase: Math.random()*Math.PI*2,
                speed: 0.2 + Math.random()*0.35
            });
        }
    }
}

function draw() {
    ctx.fillStyle = '#0a0a0a';
    ctx.fillRect(0, 0, W, H);
    t += 0.012;

    for (const d of dots) {
        const dx = mouse.x - d.x, dy = mouse.y - d.y;
        const dist = Math.hypot(dx, dy);
        let r = d.baseR;
        if (dist < 200) r += (1 - dist/200) * 10;
        r += Math.sin(t*d.speed + d.phase) * 1.0;

        const ratio = d.x / W;
        const h = 18 + ratio * 18;
        const s = 88, l = 52;
        const alpha = 0.1 + Math.sin(t*d.speed + d.phase)*0.05;

        ctx.beginPath();
        ctx.arc(d.x, d.y, Math.max(0.3, r), 0, Math.PI*2);
        ctx.fillStyle = `hsla(${h},${s}%,${l}%,${alpha})`;
        ctx.fill();
    }
    requestAnimationFrame(draw);
}

window.addEventListener('resize', resize);
window.addEventListener('mousemove', e => { mouse.x=e.clientX; mouse.y=e.clientY; });
resize(); draw();

// ── PROGRESS BAR & NAV ──
const pb = document.getElementById('progressBar');
const nav = document.getElementById('mainNav');
const heroContent = document.querySelector('.hero-content');

window.addEventListener('scroll', () => {
    const sy = window.scrollY;
    const dh = document.documentElement.scrollHeight - window.innerHeight;
    pb.style.width = (sy/dh*100) + '%';
    nav.classList.toggle('visible', sy > window.innerHeight * 0.35);
    if (sy < window.innerHeight) {
        heroContent.style.transform = `translateY(${sy*0.25}px)`;
        heroContent.style.opacity = 1 - (sy/window.innerHeight)*0.7;
    }
});

// ── SCROLL REVEAL ──
const tb = document.getElementById('terminalBody');
let tbAnimated = false;

const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
        if (e.isIntersecting) {
            e.target.classList.add('visible');
            if (e.target.querySelector && e.target.querySelector('#terminalBody') && !tbAnimated) {
                tb.classList.add('animated'); tbAnimated = true;
            }
        }
    });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.reveal').forEach(el => io.observe(el));

// ── SMOOTH SCROLL ──
document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
        e.preventDefault();
        const t = document.querySelector(a.getAttribute('href'));
        if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});

// ── LANGUAGE TOGGLE ──
const langToggle = document.querySelector('.lang-toggle');
const langSpans = langToggle.querySelectorAll('span');
let currentLang = 'en';

function setLanguage(lang) {
    currentLang = lang;
    langSpans.forEach(s => s.classList.toggle('active', s.dataset.lang === lang));
    document.querySelectorAll('[data-en][data-es]').forEach(el => {
        const text = el.getAttribute('data-' + lang);
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
            el.placeholder = text;
        } else {
            el.textContent = text;
        }
    });
    document.documentElement.lang = lang;
}

langSpans.forEach(s => {
    s.addEventListener('click', () => setLanguage(s.dataset.lang));
});

// ── VIDEO EMBED ──
const VIDEO_URL = '';
function loadVideo() {
    if (!VIDEO_URL) {
        alert(currentLang === 'en' 
            ? 'Coming soon: replace VIDEO_URL in the script with your YouTube/Vimeo embed URL.' 
            : 'Próximamente: reemplaza VIDEO_URL en el script con tu URL de embed de YouTube/Vimeo.');
        return;
    }
    const iframe = document.getElementById('videoIframe');
    const placeholder = document.getElementById('videoPlaceholder');
    iframe.src = VIDEO_URL;
    iframe.style.display = 'block';
    placeholder.style.display = 'none';
}
</script>

