<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halftone RIP Pro — The Confidence Before Production</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --carbon:      #0a0a0a;
            --charcoal:    #111111;
            --steel:       #1a1a1a;
            --iron:        #2a2a2a;
            --graphite:    #3d3d3d;
            --ember:       #e8520a;
            --ember-soft:  rgba(232, 82, 10, 0.15);
            --ember-glow:  rgba(232, 82, 10, 0.4);
            --safety:      #f5c400;
            --safety-soft: rgba(245, 196, 0, 0.12);
            --chalk:       #f0ede8;
            --smoke:       #888888;
            --deep-smoke:  #555555;
            --ok:          #3dba6b;
            --fail:        #e8520a;
            --font-display: 'Barlow Condensed', system-ui, sans-serif;
            --font-body:    'Inter', system-ui, sans-serif;
            --font-mono:    'IBM Plex Mono', monospace;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body);
            background: var(--carbon);
            color: var(--chalk);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        ::selection { background: var(--ember); color: #000; }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: var(--carbon); }
        ::-webkit-scrollbar-thumb { background: var(--graphite); border-radius: 2px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--ember); }

        .progress-bar {
            position: fixed; top: 0; left: 0; width: 0%; height: 2px;
            background: linear-gradient(90deg, var(--ember), var(--safety));
            z-index: 10000;
            transition: width 0.05s linear;
        }

        .nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
            padding: 0 48px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
            background: transparent;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0; transform: translateY(-12px);
        }
        .nav.visible {
            opacity: 1; transform: translateY(0);
            background: rgba(10, 10, 10, 0.88);
            backdrop-filter: blur(20px) saturate(1.2);
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .nav-brand {
            font-family: var(--font-display);
            font-size: 1.05rem; font-weight: 800;
            letter-spacing: 0.14em; text-transform: uppercase;
            color: var(--chalk);
        }
        .nav-brand em { color: var(--ember); font-style: normal; }
        .nav-logos { display:flex; align-items:center; gap:14px; }
        .nav-logo-hrp { display:block; width:138px; height:auto; max-height:28px; object-fit:contain; }
        .nav-logo-hrf { display:block; width:112px; height:auto; max-height:28px; object-fit:contain; opacity:0.9; }
        .footer-logo { display:block; width:190px; height:auto; max-height:36px; object-fit:contain; margin-bottom:12px; }
        @media(max-width:900px) { .nav-logo-hrf { display:none; } .nav-logo-hrp { width:122px; } }
        .nav-group { display: flex; align-items: center; gap: 32px; }
        .nav-links { display: flex; align-items: center; gap: 28px; }
        .nav-link {
            font-family: var(--font-mono);
            font-size: 0.6rem; font-weight: 500;
            text-transform: uppercase; letter-spacing: 0.14em;
            color: var(--smoke); text-decoration: none;
            transition: color 0.3s;
            position: relative;
        }
        .nav-link::after {
            content: ''; position: absolute; bottom: -4px; left: 0;
            width: 0; height: 1px; background: var(--ember);
            transition: width 0.3s;
        }
        .nav-link:hover { color: var(--chalk); }
        .nav-link:hover::after { width: 100%; }
        .lang-toggle {
            display: flex; align-items: center; gap: 0;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 6px;
            overflow: hidden;
            font-family: var(--font-mono);
            font-size: 0.58rem; font-weight: 600;
            letter-spacing: 0.1em;
            cursor: pointer;
        }
        .lang-toggle span {
            padding: 7px 14px;
            color: var(--deep-smoke);
            transition: all 0.3s;
            cursor: pointer;
        }
        .lang-toggle span.active {
            background: var(--ember); color: #000;
        }
        .lang-toggle span:not(.active):hover { color: var(--chalk); }
        .nav-cta {
            font-family: var(--font-mono);
            font-size: 0.58rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.12em;
            background: var(--ember); color: #000;
            padding: 10px 24px; border: none;
            text-decoration: none; transition: all 0.3s; cursor: pointer;
        }
        .nav-cta:hover { background: var(--safety); }

        .hero {
            position: relative; min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
        }
        .hero-canvas {
            position: absolute; top: 0; left: 0;
            width: 100%; height: 100%; z-index: 1;
        }
        .hero-vignette {
            position: absolute; inset: 0;
            background: radial-gradient(ellipse at 50% 40%, transparent 0%, var(--carbon) 70%);
            z-index: 2;
        }
        .hero-content {
            position: relative; z-index: 4;
            text-align: center; max-width: 920px; padding: 0 40px;
        }
        .hero-tag {
            display: inline-flex; align-items: center; gap: 10px;
            font-family: var(--font-mono);
            font-size: 0.58rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.28em;
            color: var(--safety); margin-bottom: 40px;
            opacity: 0; transform: translateY(20px);
            animation: revealUp 0.8s 0.5s cubic-bezier(0.4,0,0.2,1) forwards;
        }
        .pulse-dot {
            width: 6px; height: 6px; background: var(--safety);
            border-radius: 50%; animation: pulseDot 2.5s ease infinite;
        }
        @keyframes pulseDot {
            0%,100% { opacity:1; box-shadow: 0 0 0 0 rgba(245,196,0,0.45); }
            50% { opacity:0.6; box-shadow: 0 0 0 6px rgba(245,196,0,0); }
        }
        .hero-h1 {
            font-family: var(--font-display);
            font-size: clamp(2.8rem, 7.5vw, 7rem);
            font-weight: 900; line-height: 0.9;
            letter-spacing: -0.02em; text-transform: uppercase;
            margin-bottom: 32px;
        }
        .hero-h1 .line {
            display: block; opacity: 0;
            transform: translateY(60px); clip-path: inset(100% 0 0 0);
        }
        .hero-h1 .line:nth-child(1) { animation: revealLine 1s 0.8s cubic-bezier(0.4,0,0.2,1) forwards; }
        .hero-h1 .line:nth-child(2) { animation: revealLine 1s 1.0s cubic-bezier(0.4,0,0.2,1) forwards; color: var(--ember); }
        .hero-h1 .line:nth-child(3) {
            animation: revealLine 1s 1.2s cubic-bezier(0.4,0,0.2,1) forwards;
            font-size: 0.38em; letter-spacing: 0.12em; margin-top: 24px;
            color: var(--smoke); font-weight: 600;
        }
        @keyframes revealLine { to { opacity:1; transform:translateY(0); clip-path:inset(0 0 0 0); } }
        @keyframes revealUp { to { opacity:1; transform:translateY(0); } }

        .hero-desc {
            font-size: 0.9rem; color: var(--smoke);
            max-width: 520px; margin: 0 auto 48px;
            line-height: 1.9; opacity: 0;
            animation: revealUp 0.8s 1.6s cubic-bezier(0.4,0,0.2,1) forwards;
        }
        .hero-actions {
            display: flex; align-items: center; justify-content: center;
            gap: 20px; opacity: 0;
            animation: revealUp 0.8s 1.9s cubic-bezier(0.4,0,0.2,1) forwards;
            flex-wrap: wrap;
        }
        .btn-primary {
            display: inline-flex; align-items: center; gap: 12px;
            font-family: var(--font-mono);
            font-size: 0.68rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.12em;
            background: var(--ember); color: #000;
            padding: 16px 36px; text-decoration: none;
            transition: all 0.3s; cursor: pointer; border: none;
            position: relative; overflow: hidden;
        }
        .btn-primary::before {
            content: ''; position: absolute; top:0; left:-100%;
            width:100%; height:100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
            transition: left 0.6s;
        }
        .btn-primary:hover::before { left: 100%; }
        .btn-primary:hover { background: var(--safety); }
        .btn-secondary {
            display: inline-flex; align-items: center; gap: 12px;
            font-family: var(--font-mono);
            font-size: 0.68rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.12em;
            background: transparent; color: var(--chalk);
            padding: 16px 36px; text-decoration: none;
            transition: all 0.3s; border: 1.5px solid var(--graphite);
        }
        .btn-secondary:hover { border-color: var(--chalk); }

        .scroll-indicator {
            position: absolute; bottom: 40px; left: 50%;
            transform: translateX(-50%); z-index: 5;
            display: flex; flex-direction: column; align-items: center; gap: 12px;
            opacity: 0; animation: revealUp 0.8s 2.4s cubic-bezier(0.4,0,0.2,1) forwards;
        }
        .scroll-indicator span {
            font-family: var(--font-mono);
            font-size: 0.5rem; text-transform: uppercase;
            letter-spacing: 0.25em; color: var(--deep-smoke);
        }
        .scroll-line {
            width: 1px; height: 48px;
            background: linear-gradient(to bottom, var(--graphite), transparent);
            position: relative; overflow: hidden;
        }
        .scroll-line::after {
            content: ''; position: absolute; top:-100%; left:0;
            width:100%; height:100%; background: var(--ember);
            animation: scrollPulse 2.5s ease infinite;
        }
        @keyframes scrollPulse { 0%{top:-100%} 100%{top:200%} }

        .marquee {
            background: var(--ember); color: #000;
            padding: 14px 0; overflow: hidden; white-space: nowrap;
        }
        .marquee-inner {
            display: inline-block;
            animation: marqueeScroll 35s linear infinite;
            font-family: var(--font-mono);
            font-size: 0.62rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.2em;
        }
        @keyframes marqueeScroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

        .section {
            position: relative; padding: 140px 48px;
            max-width: 1280px; margin: 0 auto;
        }
        .section-wide { max-width: 1400px; }
        .section-full { max-width: none; }

        .eyebrow {
            font-family: var(--font-mono);
            font-size: 0.55rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.35em;
            color: var(--ember); margin-bottom: 24px;
            display: flex; align-items: center; gap: 16px;
        }
        .eyebrow::before {
            content: ''; width: 36px; height: 1.5px;
            background: var(--ember); flex-shrink: 0;
        }
        .eyebrow.center { justify-content: center; }
        .section-h2 {
            font-family: var(--font-display);
            font-size: clamp(2.2rem, 5vw, 4rem);
            font-weight: 900; line-height: 0.95;
            letter-spacing: -0.01em; text-transform: uppercase;
            margin-bottom: 28px;
        }
        .section-h2 .em { color: var(--ember); }
        .section-h2 .safe { color: var(--safety); }
        .section-desc {
            font-size: 0.9rem; color: var(--smoke);
            line-height: 1.85; max-width: 540px;
        }

        .reveal { opacity:0; transform:translateY(40px); transition: all 0.9s cubic-bezier(0.4,0,0.2,1); }
        .reveal.visible { opacity:1; transform:translateY(0); }
        .reveal-d1 { transition-delay: 0.1s; }
        .reveal-d2 { transition-delay: 0.2s; }
        .reveal-d3 { transition-delay: 0.3s; }
        .reveal-d4 { transition-delay: 0.4s; }
        .reveal-d5 { transition-delay: 0.5s; }

        .bg-steel { background: var(--charcoal); }

        /* PROBLEM */
        .problem-layout {
            display: grid; grid-template-columns: 1fr 1.05fr;
            gap: 80px; align-items: center;
        }
        .problem-terminal {
            background: var(--carbon); border: 1px solid var(--iron);
            font-family: var(--font-mono);
            font-size: 0.68rem; line-height: 1.9;
            overflow: hidden; border-radius: 4px;
        }
        .terminal-header {
            background: var(--iron); padding: 10px 16px;
            display: flex; align-items: center; gap: 8px;
        }
        .tdot { width:10px; height:10px; border-radius:50%; }
        .tdot.r { background:#ff5f56; }
        .tdot.y { background:#ffbd2e; }
        .tdot.g { background:#27c93f; }
        .terminal-label { margin-left:10px; color:var(--smoke); font-size:0.55rem; letter-spacing:0.08em; }
        .terminal-body { padding: 22px 24px; color: var(--smoke); }
        .t-line { margin-bottom: 4px; opacity:0; }
        .t-line.err { color: #ff5f56; }
        .t-line.warn { color: var(--safety); }
        .t-line.ok { color: #27c93f; }
        .t-line.cmd { color: var(--ember); }
        .terminal-body.animated .t-line { animation: typeLine 0.06s forwards; }
        .terminal-body.animated .t-line:nth-child(1) { animation-delay:0.1s }
        .terminal-body.animated .t-line:nth-child(2) { animation-delay:0.4s }
        .terminal-body.animated .t-line:nth-child(3) { animation-delay:0.7s }
        .terminal-body.animated .t-line:nth-child(4) { animation-delay:1.0s }
        .terminal-body.animated .t-line:nth-child(5) { animation-delay:1.3s }
        .terminal-body.animated .t-line:nth-child(6) { animation-delay:1.6s }
        .terminal-body.animated .t-line:nth-child(7) { animation-delay:1.9s }
        .terminal-body.animated .t-line:nth-child(8) { animation-delay:2.2s }
        @keyframes typeLine { to { opacity:1; } }

        /* VIE */
        .vie-section { background: var(--carbon); }
        .vie-layout {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 80px; align-items: center;
        }
        .vie-diagram {
            display: flex; flex-direction: column; gap: 0;
            background: var(--charcoal); border: 1px solid var(--iron);
            border-radius: 4px; overflow: hidden;
        }
        .vie-step {
            padding: 20px 28px;
            display: flex; align-items: center; gap: 16px;
            border-bottom: 1px solid var(--iron);
            transition: background 0.3s;
        }
        .vie-step:last-child { border-bottom: none; }
        .vie-step:hover { background: rgba(232,82,10,0.04); }
        .vie-step-num {
            font-family: var(--font-display);
            font-size: 1.4rem; font-weight: 900; color: var(--ember);
            width: 32px; flex-shrink: 0;
        }
        .vie-step-text {
            font-family: var(--font-mono);
            font-size: 0.72rem; color: var(--chalk);
            letter-spacing: 0.04em;
        }
        .vie-step-text small {
            display: block; color: var(--smoke); font-size: 0.6rem; margin-top: 2px;
        }
        .vie-arrow {
            text-align: center; padding: 6px 0;
            color: var(--graphite); font-size: 0.7rem;
        }

        /* CONFIDENCE */
        .confidence-section { background: var(--charcoal); }
        .confidence-card {
            background: var(--carbon); border: 1px solid var(--iron);
            border-radius: 6px; padding: 48px;
            max-width: 480px; margin: 0 auto;
            text-align: center;
            position: relative; overflow: hidden;
        }
        .confidence-card::before {
            content: ''; position: absolute; top:0; left:0; right:0;
            height: 3px; background: linear-gradient(90deg, var(--ember), var(--safety));
        }
        .confidence-label {
            font-family: var(--font-mono);
            font-size: 0.55rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.3em;
            color: var(--smoke); margin-bottom: 20px;
        }
        .confidence-score {
            font-family: var(--font-display);
            font-size: 5rem; font-weight: 900; line-height: 1;
            color: var(--chalk); margin-bottom: 8px;
        }
        .confidence-score span { font-size: 1.5rem; color: var(--smoke); }
        .confidence-grade {
            font-family: var(--font-display);
            font-size: 2rem; font-weight: 800; color: var(--safety);
            margin-bottom: 20px;
        }
        .confidence-meta {
            display: flex; justify-content: center; gap: 24px;
            margin-bottom: 28px;
        }
        .confidence-meta-item { text-align: center; }
        .confidence-meta-item .value {
            font-family: var(--font-display);
            font-size: 1.2rem; font-weight: 700; color: var(--chalk);
        }
        .confidence-meta-item .label {
            font-family: var(--font-mono);
            font-size: 0.5rem; color: var(--smoke);
            text-transform: uppercase; letter-spacing: 0.15em;
            margin-top: 4px;
        }
        .confidence-status {
            font-family: var(--font-mono);
            font-size: 0.62rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.15em;
            color: var(--ok); border: 1px solid rgba(61,186,107,0.3);
            padding: 8px 20px; display: inline-block;
        }
        .confidence-list {
            text-align: left; margin-top: 28px;
            display: flex; flex-direction: column; gap: 10px;
        }
        .confidence-list-item {
            font-family: var(--font-mono);
            font-size: 0.65rem; color: var(--smoke);
            display: flex; align-items: center; gap: 10px;
        }
        .confidence-list-item .check { color: var(--ok); font-weight: 700; }

        /* WORKFLOW */
        .workflow-section { background: var(--carbon); }
        .workflow-track {
            display: flex; align-items: stretch; gap: 2px;
            background: var(--iron); margin-top: 64px;
            border-radius: 4px; overflow: hidden;
        }
        .workflow-step {
            flex: 1; background: var(--charcoal); padding: 36px 20px;
            text-align: center; position: relative;
            transition: background 0.4s;
        }
        .workflow-step:hover { background: var(--steel); }
        .workflow-step::after {
            content: '↓'; position: absolute; bottom: -18px; left: 50%;
            transform: translateX(-50%);
            font-family: var(--font-mono); font-size: 0.7rem; color: var(--graphite);
            z-index: 2;
        }
        .workflow-step:last-child::after { display: none; }
        .workflow-icon {
            font-size: 1.8rem; margin-bottom: 16px;
            display: block;
        }
        .workflow-title {
            font-family: var(--font-display);
            font-size: 0.85rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.04em;
            margin-bottom: 10px; color: var(--chalk);
        }
        .workflow-desc {
            font-family: var(--font-body);
            font-size: 0.7rem; color: var(--smoke); line-height: 1.7;
        }

        /* KNOWLEDGE ENGINE */
        .knowledge-section { background: var(--charcoal); }
        .knowledge-layout {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 80px; align-items: center;
        }
        .knowledge-visual {
            background: var(--carbon); border: 1px solid var(--iron);
            border-radius: 4px; padding: 40px;
            display: flex; flex-direction: column; gap: 20px;
        }
        .knowledge-item {
            display: flex; align-items: center; gap: 16px;
            padding: 16px 20px;
            background: var(--charcoal);
            border: 1px solid var(--iron);
            border-radius: 4px;
            transition: all 0.3s;
        }
        .knowledge-item:hover {
            border-color: var(--ember);
            background: rgba(232,82,10,0.04);
        }
        .knowledge-item-icon {
            font-size: 1.4rem; flex-shrink: 0;
        }
        .knowledge-item-text {
            font-family: var(--font-mono);
            font-size: 0.72rem; color: var(--chalk);
        }
        .knowledge-item-text small {
            display: block; color: var(--smoke); font-size: 0.6rem; margin-top: 2px;
        }

        /* FEATURES */
        .features-section { background: var(--charcoal); }
        .features-grid {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 2px; background: var(--iron); margin-top: 72px;
        }
        .feature-card {
            background: var(--carbon); padding: 48px 36px;
            position: relative; overflow: hidden;
            transition: background 0.4s;
        }
        .feature-card::after {
            content: ''; position: absolute; top:0; left:0; right:0;
            height: 2px; background: var(--ember);
            transform: scaleX(0); transform-origin: left;
            transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
        }
        .feature-card:hover::after { transform: scaleX(1); }
        .feature-card:hover { background: var(--charcoal); }
        .feature-badge {
            position: absolute; top: 20px; right: 20px;
            font-family: var(--font-mono);
            font-size: 0.5rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.12em;
            color: var(--ember); border: 1px solid var(--ember);
            padding: 4px 10px;
        }
        .feature-icon {
            font-size: 2.2rem; margin-bottom: 22px;
            display: inline-block; transition: transform 0.3s;
        }
        .feature-card:hover .feature-icon { transform: scale(1.08); }
        .feature-card h3 {
            font-family: var(--font-display);
            font-size: 1.3rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.02em;
            margin-bottom: 14px;
        }
        .feature-card p {
            font-size: 0.78rem; color: var(--smoke); line-height: 1.8;
        }

        /* VIDEO */
        .video-section { background: var(--carbon); }
        .video-layout {
            display: grid; grid-template-columns: 1.1fr 0.9fr;
            gap: 72px; align-items: center;
        }
        .video-embed-wrap {
            position: relative; background: var(--charcoal);
            border: 1px solid var(--iron); overflow: hidden;
            aspect-ratio: 16/9; border-radius: 4px;
        }
        .video-embed-wrap iframe {
            position: absolute; top:0; left:0; width:100%; height:100%;
            border:none;
        }
        .video-placeholder {
            position: absolute; inset:0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 16px;
            background: var(--charcoal); cursor: pointer;
            transition: background 0.3s;
