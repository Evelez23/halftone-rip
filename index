            .problem-layout, .vie-layout, .comparison-wrap, .knowledge-layout, .video-layout { grid-template-columns: 1fr; }
            .features-grid, .gallery-grid, .specs-grid, .why-grid { grid-template-columns: 1fr; }
            .workflow-track { flex-direction: column; }
