        }
        .spec-cell-title {
            font-family: var(--font-display);
            font-size: 1rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.02em;
        }
        .spec-data {
            font-size: 0.78rem; color: var(--smoke); line-height: 2;
        }
        .spec-data strong { color: var(--chalk); font-weight: 500; }

        /* WHY CHOOSE */
        .why-section { background: var(--carbon); }
