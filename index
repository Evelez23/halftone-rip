        .visual-slot {
            position: relative; overflow: hidden; isolation: isolate;
            min-height: 220px; aspect-ratio: 16 / 9;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid rgba(232,82,10,0.42);
            border-radius: 5px;
            background:
                linear-gradient(135deg, rgba(232,82,10,0.07), transparent 45%),
                repeating-linear-gradient(135deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 12px),
                #0a0a0a;
        }
        .visual-slot::before {
            content: ''; position: absolute; inset: 10px;
            border: 1px dashed rgba(245,196,0,0.28); pointer-events: none;
        }
        .visual-slot-content {
            position: relative; z-index: 1; padding: 24px;
            text-align: center; max-width: 560px;
        }
        .visual-slot-mark {
            display: block; font-family: var(--font-mono);
            font-size: 1.8rem; line-height: 1; color: var(--ember);
            margin-bottom: 12px; opacity: .85;
        }
        .visual-slot-title {
            display: block; font-family: var(--font-display);
            font-size: 1rem; font-weight: 800; letter-spacing: .08em;
            text-transform: uppercase; color: var(--chalk); margin-bottom: 7px;
        }
        .visual-slot-note {
            display: block; font-family: var(--font-mono);
            font-size: .55rem; line-height: 1.7; letter-spacing: .08em;
            text-transform: uppercase; color: var(--smoke);
        }
        .visual-slot-wide { margin-top: 56px; }
        .visual-slot-inline { margin-top: 36px; }
        .visual-slot-caption {
            margin-top: 10px; font-family: var(--font-mono);
            font-size: .55rem; letter-spacing: .1em; text-transform: uppercase;
            color: var(--deep-smoke); text-align: right;
        }
        @media (max-width: 900px) {
            .visual-slot { min-height: 170px; }
            .visual-slot-wide, .visual-slot-inline { margin-top: 32px; }
        }

    </style>
</head>
