        .why-card p {
            font-size: 0.78rem; color: var(--smoke); line-height: 1.7;
        }

        /* CTA */
        .cta-section {
            background: var(--steel);
            text-align: center; padding: 160px 48px;
        }
        .cta-h2 {
            font-family: var(--font-display);
            font-size: clamp(2.8rem, 7vw, 6rem);
