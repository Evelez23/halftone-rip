            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 2px; background: var(--iron); margin-top: 64px;
        }
        .why-card {
            background: var(--charcoal); padding: 40px 32px;
            text-align: center; transition: background 0.3s;
