        /* COMPARISON */
        .comparison-section { background: var(--carbon); }
        .comparison-wrap {
            display: grid; grid-template-columns: 1fr 1fr;
            border: 1px solid var(--iron); margin-top: 64px;
            border-radius: 4px; overflow: hidden;
        }
        .comp-side { padding: 48px; }
        .comp-side.before {
            background: var(--charcoal);
            border-right: 1px solid var(--iron);
        }
        .comp-side.after { background: rgba(232,82,10,0.04); }
        .comp-label {
            font-family: var(--font-mono);
            font-size: 0.55rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.2em;
            margin-bottom: 32px;
            display: flex; align-items: center; gap: 10px;
        }
        .comp-label.before { color: #ff5f56; }
        .comp-label.after { color: var(--safety); }
        .comp-label::before { content:''; width:6px; height:6px; border-radius:50%; flex-shrink:0; }
        .comp-label.before::before { background:#ff5f56; }
        .comp-label.after::before { background: var(--safety); }
        .comp-list { display:flex; flex-direction:column; gap:16px; }
        .comp-item {
            font-size: 0.82rem; color: var(--smoke);
            padding-left: 24px; position: relative; line-height: 1.6;
        }
        .comp-item::before { content:'×'; position:absolute; left:0; color:#ff5f56; font-weight:700; }
        .comp-side.after .comp-item::before { content:'✓'; color: var(--safety); }

        /* STORY */
        .story-section { background: var(--carbon); text-align: center; }
        .story-section .section-h2 { margin: 0 auto 28px; }
        .story-section .section-desc { margin: 0 auto; }
        .story-quote {
            font-family: var(--font-display);
            font-size: clamp(1.6rem, 3.5vw, 2.8rem);
            font-weight: 800; line-height: 1.1;
            text-transform: uppercase;
            max-width: 800px; margin: 64px auto 0;
            color: var(--chalk);
        }
        .story-quote .em { color: var(--ember); }

        /* MISTAKE */
        .mistake-section { background: var(--charcoal); text-align: center; }
        .mistake-number {
            font-family: var(--font-display);
            font-size: clamp(4rem, 10vw, 10rem);
            font-weight: 900; line-height: 0.85;
            color: var(--ember); opacity: 0.15;
            margin-bottom: -20px;
        }
        .mistake-text {
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 4vw, 3.2rem);
            font-weight: 900; line-height: 1;
            text-transform: uppercase;
            max-width: 700px; margin: 0 auto 32px;
        }
        .mistake-text .em { color: var(--ember); }
        .mistake-text .safe { color: var(--safety); }
        .mistake-divider {
            width: 60px; height: 2px; background: var(--iron);
            margin: 0 auto 32px;
        }

        /* GALLERY */
        .gallery-section { background: var(--carbon); }
        .gallery-grid {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 2px; background: var(--iron); margin-top: 64px;
        }
        .gallery-item {
            position: relative; overflow: hidden; cursor: pointer;
            background: var(--charcoal); aspect-ratio: 16/10;
        }
        .gallery-item img {
            width:100%; height:100%; object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4,0,0.2,1);
            display: block;
        }
        .gallery-item:hover img { transform: scale(1.03); }
        .gallery-placeholder {
            width:100%; height:100%;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 12px;
            background: var(--charcoal);
        }
        .gallery-placeholder-icon { font-size: 2.8rem; opacity:0.25; }
        .gallery-placeholder-label {
            font-family: var(--font-mono);
            font-size: 0.55rem; text-transform: uppercase;
            letter-spacing: 0.18em; color: var(--graphite);
        }
        .gallery-caption {
            position: absolute; bottom:0; left:0; right:0;
            background: linear-gradient(transparent, rgba(10,10,10,0.95));
            padding: 36px 20px 16px;
            font-size: 0.7rem; color: var(--chalk);
            letter-spacing: 0.04em;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
        }
        .gallery-item:hover .gallery-caption { transform: translateY(0); }
        .gallery-caption strong {
            font-family: var(--font-display);
            color: var(--safety); display: block; margin-bottom: 4px;
            font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em;
        }

        /* ROADMAP */
        .roadmap-section { background: var(--charcoal); }
        .roadmap-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 48px; margin-top: 64px;
        }
        .roadmap-col h4 {
            font-family: var(--font-mono);
            font-size: 0.55rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.2em;
            color: var(--smoke); margin-bottom: 24px;
            padding-bottom: 12px; border-bottom: 1px solid var(--iron);
        }
        .roadmap-col.today h4 { color: var(--safety); border-color: var(--safety); }
        .roadmap-col.tomorrow h4 { color: var(--ember); border-color: var(--ember); }
        .roadmap-list { display: flex; flex-direction: column; gap: 14px; }
        .roadmap-item {
            font-size: 0.82rem; color: var(--smoke);
            padding-left: 20px; position: relative;
        }
        .roadmap-item::before {
            content: '—'; position: absolute; left: 0; color: var(--graphite);
        }

        /* SPECS */
        .specs-section { background: var(--charcoal); }
        .specs-grid {
            display: grid; grid-template-columns: repeat(2, 1fr);
            gap: 2px; background: var(--iron); margin-top: 64px;
        }
        .spec-cell {
            background: var(--carbon); padding: 40px 36px;
            transition: background 0.3s;
        }
        .spec-cell:hover { background: var(--charcoal); }
        .spec-cell-head {
            display: flex; align-items: center; gap: 14px;
            margin-bottom: 20px;
        }
        .spec-tag {
            font-family: var(--font-mono);
            font-size: 0.52rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.12em;
